[Unit]
Description=1111bot o3333o heikin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/srv/1111bot
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/1111bot/.venv/bin/python /srv/1111bot/run_ha.py
Restart=always
RestartSec=5
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
